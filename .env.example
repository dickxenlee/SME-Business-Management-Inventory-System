DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO
DJANGO_AXES_ENABLED=True
DJANGO_AXES_FAILURE_LIMIT=5
DJANGO_AXES_COOLOFF_MINUTES=15

DB_NAME=sme_manager
DB_USER=sme_manager_user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=
DB_CONNECT_TIMEOUT=5
DB_CONN_MAX_AGE=0

# Percentage applied to new Sales. Leave at 0 unless the business is SST
# registered; the rate is snapshotted onto each Sale when it is created.
# Outgoing mail, used only for password resets. Without EMAIL_HOST the reset
# flow is switched off rather than offered as a link that sends nothing;
# development prints the link to the console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
PASSWORD_RESET_TIMEOUT_SECONDS=3600

SALES_TAX_RATE=0
SALES_TAX_LABEL=SST

INVOICE_SELLER_NAME=Example SME Business
INVOICE_SELLER_ADDRESS=123 Example Street, Kuala Lumpur
