DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO
DJANGO_AXES_ENABLED=True
DJANGO_AXES_FAILURE_LIMIT=5
DJANGO_AXES_COOLOFF_MINUTES=15

DB_NAME=sme_manager
DB_USER=sme_manager_user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=
DB_CONNECT_TIMEOUT=5
DB_CONN_MAX_AGE=0

# Percentage applied to new Sales. Leave at 0 unless the business is SST
# registered; the rate is snapshotted onto each Sale when it is created.
SALES_TAX_RATE=0
SALES_TAX_LABEL=SST

INVOICE_SELLER_NAME=Example SME Business
INVOICE_SELLER_ADDRESS=123 Example Street, Kuala Lumpur
